# ==============================================================================
# Meta Graph API Credentials & Configuration
# ==============================================================================

# Primary Meta User Access Token (with ads_management, ads_read, pages_read_engagement, pages_show_list, instagram_basic)
META_ACCESS_TOKEN=your_meta_user_access_token_here

# Optional: Dedicated Page Access Token (if omitted, automatically resolved from /me/accounts)
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here

# Facebook Page ID (e.g. XXX...)
META_PAGE_ID=your_facebook_page_id_here

# Meta Developer App Credentials (for OAuth & token verification)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# Meta Graph API Version (defaults to v23.0)
META_GRAPH_API_VERSION=v23.0

# Server Transport & Network Configuration
# Set MCP_TRANSPORT to 'streamable-http' for web/Cloud Run, or leave unset for local stdio
MCP_TRANSPORT=stdio
PORT=8080
HOST=0.0.0.0
